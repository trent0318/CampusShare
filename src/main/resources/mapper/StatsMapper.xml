<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campusshare.mapper.StatsMapper">

    <select id="countResources" resultType="long">
        SELECT COUNT(*) FROM `resource`
    </select>

    <select id="countUsers" resultType="long">
        SELECT COUNT(*) FROM `user`
    </select>

    <select id="countReservations" resultType="long">
        SELECT COUNT(*) FROM `reservation`
    </select>

    <select id="countReservationsByStatus" resultType="long">
        SELECT COUNT(*) FROM `reservation` WHERE status = #{status}
    </select>

    <!-- 热门资源：按预约次数降序，取前 N 个 -->
    <select id="selectHotResources" resultType="com.campusshare.vo.HotResourceVO">
        SELECT rv.resource_id AS resourceId,
               r.name AS resourceName,
               COUNT(*) AS reservationCount
        FROM `reservation` rv
        LEFT JOIN `resource` r ON rv.resource_id = r.id
        GROUP BY rv.resource_id, r.name
        ORDER BY reservationCount DESC
        LIMIT #{limit}
    </select>

</mapper>
